HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
# Comma-separated exact frontend origins; include your InfinityFree HTTPS domain.
# Blank permits same-origin development only.
ALLOWED_ORIGINS=
# Set to 1 only behind a trusted reverse proxy; enables HTTPS detection for accounts.
TRUST_PROXY=0
# If deployed behind HTTPS, redirect HTTP at the hosting provider.
NODE_ENV=development
